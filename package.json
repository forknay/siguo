{
  "name": "siguo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"pnpm -C server dev\" \"pnpm -C client dev\"",
    "build": "pnpm -C shared build && pnpm -C client build && pnpm -C server build",
    "start": "pnpm -C server start",
    "online": "bash scripts/online.sh",
    "test": "pnpm -C shared test",
    "bot-eval": "pnpm -C shared bot-eval",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
